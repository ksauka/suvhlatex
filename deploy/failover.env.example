# Copy to ~/.config/suvhlatex/failover.env on each machine.
# Keep this file local; do not commit machine names or credentials.

# primary on the desktop, secondary on the laptop
SUVHLATEX_FAILOVER_ROLE=primary
SUVHLATEX_FAILOVER_PEER_USER=suvh
SUVHLATEX_FAILOVER_PEER_HOST=replace-with-peer-tailscale-hostname

# Absolute project-data paths on the local and peer machines.
SUVHLATEX_DATA_ROOT=/home/suvh/projects/suvhlatex/data
SUVHLATEX_PEER_DATA_ROOT=/home/suvh/projects/suvhlatex/data
