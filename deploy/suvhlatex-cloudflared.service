[Unit]
Description=Cloudflare Quick Tunnel for suvhlatex
After=network-online.target suvhlatex.service
Wants=network-online.target suvhlatex.service

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env cloudflared tunnel --url http://127.0.0.1:8765 --no-autoupdate
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
